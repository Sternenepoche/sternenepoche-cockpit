#![enable(implicit_some)]
// Sternenepoche – Regelwerk.
// Alle Zahlen des Spiels stehen in dieser Datei. Die Engine rechnet nur mit ihnen,
// und der Regeltext für die Agenten wird aus ihnen erzeugt. Der Hash dieser Datei
// steht in jedem Protokoll. Die Werte sind Startwerte fürs Balancing mit Skriptbots.
(
    version: "0.2.0-online.1",

    welt: (
        sektoren: 2,
        systeme_je_sektor: 60,
        plaetze_je_system: 12,
        nebel_abstand: 10,          // Nebelsysteme: 5, 15, 25, ... (sechs pro Sektor)
        nebel_versatz: 5,
        guertel_abstand: 5,         // Asteroidengürtel: 3, 8, 13, ... (jedes fünfte System)
        guertel_versatz: 3,
        reichtum_min: 0.7,
        reichtum_max: 1.4,
        epoche_tage: 365,
        fenster_sekunden: 900,
        heimat_position: 6,
        heimat_felder: 180,
        start_abstand: 2,           // Startsysteme liegen mindestens so weit auseinander
        start_bevoelkerung: 1000,
        start_credits: 2000,
        start_stabilitaet: 50.0,
        start_steuersatz: 10,
        grundwohnraum: 1200,
        start_bestand: { erz: 2000, kristall: 1200, deuterium: 400, nahrung: 800 },
        start_gebaeude: { erzmine: 1, kristallmine: 1, farm: 1, solarkraftwerk: 1, wohnblock: 1, lager: 1 },
        max_gebaeudestufe: 40,
    ),

    zonen: {
        glut:  (von: 1, bis: 3,  felder_min: 80,  felder_max: 140, solar: 1.4, deuterium: 0.6, nahrung: 0.7),
        leben: (von: 4, bis: 8,  felder_min: 150, felder_max: 230, solar: 1.0, deuterium: 1.0, nahrung: 1.3),
        frost: (von: 9, bis: 12, felder_min: 100, felder_max: 180, solar: 0.7, deuterium: 1.5, nahrung: 0.6),
    },

    voelker: {
        aurelianer: (ladung: 1.2, marktgebuehr: 0.5, waffen: 0.9, steuer: 1.1),
        krath:      (waffen: 1.15, werftzeit: 0.85, forschung: 0.85, pluenderquote: 0.5),
        veyari:     (wachstum: 1.1, nahrung: 1.25, panzerung: 0.85, kolonieschiff: 0.75),
        syntheten:  (forschung: 1.15, energie: 1.1, wachstum: 0.85, ohne_nahrung: true),
    },

    wirtschaft: (
        wachstum_je_tag: 0.12,              // logistisch gebremst: bei halb vollem Wohnraum 6 Prozent
        arbeitsquote: 0.6,
        fachkraefte_basis: 30,
        fachkraefte_je_akademie: 60.0,
        nahrung_je_1000: 40.0,              // je Stunde
        konsum_je_1000: 3.0,                // je Stunde
        energie_je_1000_syntheten: 25.0,    // Balance 04.10.: mit 30 lagen die Syntheten 15 Prozent zurück
        hunger_min: -0.5,
        steuer_je_einwohner_stunde: 0.03,   // Credits bei 100 Prozent Steuersatz
        unterhalt_schiffe_je_tag: 0.005,      // Balance 04.10.: Flotten kosten spürbar Credits
        verwaltung_je_kolonie_tag: 300,
        desertion_nach_tagen: 3,
        desertion_anteil: 0.1,
        ertragswachstum: 1.1,
        lager_roh: 8000,
        lager_verarbeitet: 1500,
        lager_selten: 400,
        lager_faktor: 1.6,
        bunker_je_stufe: 20000,               // Balance 04.10.: Schutz, der zu den Lagergrößen passt
        bunker_verarbeitet_anteil: 0.2,
        bauzeit_teiler: 2500,
        min_bauzeit_sekunden: 60,
        warteschlange: 5,
        forschung_warteschlange: 3,
        rezepte: {
            legierung:  { erz: 4.0 },
            elektronik: { kristall: 2.0, erz: 1.0 },
            konsumgut:  { erz: 1.0, kristall: 1.0, deuterium: 0.5 },
        },
        fusion_deuterium: 6.0,
        energietechnik_bonus: 0.05,
        werkstoffkunde_bonus: 0.05,
        automatisierung_bonus: 0.04,
        agrar_bonus: 0.08,
        xeno_bonus: 0.1,
        terraforming_felder: 6,
        siedler: 3000,
        habitat_wohnraum: 2000,
        kolonien_max: 8,
        bauteile: {
            antriebskern: { erz: 2000, kristall: 1000, legierung: 200, elektronik: 100 },
            habitatmodul: { erz: 1500, kristall: 500, legierung: 150, elektronik: 50, konsumgut: 100 },
        },
