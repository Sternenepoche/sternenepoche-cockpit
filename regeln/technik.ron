// Technik v1 (neue Welten ab 18.10.2026; Karl: „Ja, einführen“): Antriebswechsel per Forschung und Plasmatechnik.
// Wirkt nur in Welten, die Welt::technik_aktivieren bei Spielbeginn aufrufen (Server, lokale Online-Partie); die
// Bytes dieser Datei gehen dabei einmalig in den Regelhash ein. Laufende Welten, online-v1.ron, regelwerk.ron,
// flottenausbau.json und flottenausbau-v1.json bleiben unberührt. Begründung und Messung:
// docs/ANTRIEBE-UND-PLASMATECHNIK.md.
(
    version: 1,
    // Je Schiff: ab Forschung/Stufe fliegt es mit einem anderen Antrieb, neuem Grundtempo und neuem Verbrauch.
    // Tempo im Flug = Grundtempo × (1 + antrieb_bonus des neuen Antriebs × dessen Stufe); Treibstoff je Strecke wie
    // bisher 1 + Σ Verbrauch × d × s² / treibstoff_teiler. Von mehreren erreichten Zeilen gilt die letzte.
    antriebswechsel: {
        // OGame: Kleiner Transporter ab Impulsantrieb 5 schneller als der große. Grundtempo 12.000 statt 10.000
        // (Verbrennung), Verbrauch doppelt; bleibt unter dem Schnellfrachter (18.000, Impuls).
        kleiner_transporter: [
            (forschung: impulsantrieb, stufe: 5, antrieb: impulsantrieb, tempo: 12000, verbrauch: 20),
        ],
        // OGame: Recycler ab Impuls 17 (4.000) und Hyperraum 15 (6.000). Bei uns liegen die erreichbaren Stufen
        // niedriger (Forschungspunkte verdoppeln sich je Stufe): Impuls 8 und Hyperraum 6 (wie Weltenkrümmer).
        recycler: [
            (forschung: impulsantrieb, stufe: 8, antrieb: impulsantrieb, tempo: 4000, verbrauch: 600),
            (forschung: hyperraumantrieb, stufe: 6, antrieb: hyperraumantrieb, tempo: 6000, verbrauch: 900),
        ],
        // OGame: Bomber ab Hyperraum 8 so schnell wie der Zerstörer. Unser Bomber fliegt von Anfang an mit
        // Hyperraum und Grundtempo 5.000 wie der Zerstörer; der Strategische Bomber (3.800) holt ab Hyperraum 8 auf.
        strategischer_bomber: [
            (forschung: hyperraumantrieb, stufe: 8, antrieb: hyperraumantrieb, tempo: 5000, verbrauch: 1700),
        ],
    },
    // Plasmatechnik (OGame: +1 % Metall, +0,66 % Kristall, +0,33 % Deuterium je Stufe). Bei uns doppelt je Stufe,
    // weil die erreichbaren Stufen etwa halb so hoch liegen; Verhältnis 3 : 2 : 1 wie im Vorbild.
    plasmatechnik: (kosten: {erz: 2000, kristall: 4000, deuterium: 1000}, faktor: 2.0, fp: 1000.0, ab_stufe: 4, labor: 4,
        wirkung: "+2 % Erz, +1,33 % Kristall und +0,67 % Deuterium je Stufe aus Minen und Synthesizer, braucht Energietechnik 5"),
    plasmatechnik_braucht: {energietechnik: 5},
    plasma_je_stufe: {erz: 0.02, kristall: 0.0133, deuterium: 0.0067},
    // Fusionskraftwerke je Volk (Karl 20.10.2026): Syntheten sind zu Anfang auf Strom angewiesen; ihre Fusionskraftwerke
    // liefern bei gleichen Kosten 30 % mehr als die anderer Völker (statt ihres allgemeinen Energiefaktors 1,1).
    fusion_volk: {syntheten: 1.3},
    // Berichtigte Wirkungstexte neuer Welten: einen „Bomberschutz“ (nur bestimmte Schiffe treffen Bomber) gab es im
    // Kern nie; Vorlieben geben Boni, keine Immunität. Die eingefrorenen Texte in flottenausbau.json bleiben (v1).
    wirkung: {
        bomber: "Bodenbekämpfung: vier Ziele und Schnellfeuer gegen Raketenwerfer, Lasergeschütze und Ionengeschütze; im Flottenkampf schwach – braucht Geleit gegen Schwere Jäger und Flottenkreuzer.",
        schlachtschiff: "Linienschiff gegen Kreuzer: jagt Kreuzer und Flottenkreuzer, erfasst Schild- und Raketenkreuzer und Bomber; verliert gegen Zerstörer, Schlachtkreuzer und Jägerschwärme.",
    },
)
